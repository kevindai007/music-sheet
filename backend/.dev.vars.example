# Set at least one AI key. With both set, Anthropic is used unless AI_PROVIDER says otherwise.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# Optional:
# AI_PROVIDER=openai
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.5
APP_TOKEN=change-me
# Sign-in (optional locally; X-App-Token works without it):
# SESSION_SECRET=any-long-random-string
# GOOGLE_CLIENT_IDS=123-abc.apps.googleusercontent.com
# DAILY_LIMIT=20
